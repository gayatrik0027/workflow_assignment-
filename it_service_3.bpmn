<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_ITServiceRequest" targetNamespace="http://example.com/bpmn">
 <bpmn:process id="ITServiceRequest" name="IT Service Request" isExecutable="true">
  <bpmn:startEvent id="S" name="Employee submits IT support request"/>
  <bpmn:task id="A" name="IT help desk receives the request"/>
  <bpmn:task id="B" name="Check severity of problem"/>
  <bpmn:exclusiveGateway id="G1" name="Problem severity?"/>
  <bpmn:task id="C" name="Assign to support technician"/>
  <bpmn:task id="D" name="Assign to senior technician"/>
  <bpmn:task id="E" name="Technician investigates the problem"/>
  <bpmn:exclusiveGateway id="G2" name="Problem resolved?"/>
  <bpmn:task id="F" name="Technician fixes the problem"/>
  <bpmn:task id="G" name="Escalate to external service provider"/>
  <bpmn:task id="H" name="Help desk updates request status"/>
  <bpmn:task id="I" name="Employee receives resolution notification"/>
  <bpmn:endEvent id="J" name="Process ends"/>
  <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
  <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="B"/>
  <bpmn:sequenceFlow id="f3" sourceRef="B" targetRef="G1"/>
  <bpmn:sequenceFlow id="f4" sourceRef="G1" targetRef="C" name="Low/Medium"/>
  <bpmn:sequenceFlow id="f5" sourceRef="G1" targetRef="D" name="High"/>
  <bpmn:sequenceFlow id="f6" sourceRef="C" targetRef="E"/>
  <bpmn:sequenceFlow id="f7" sourceRef="D" targetRef="E"/>
  <bpmn:sequenceFlow id="f8" sourceRef="E" targetRef="G2"/>
  <bpmn:sequenceFlow id="f9" sourceRef="G2" targetRef="F" name="Yes"/>
  <bpmn:sequenceFlow id="f10" sourceRef="G2" targetRef="G" name="No"/>
  <bpmn:sequenceFlow id="f11" sourceRef="F" targetRef="H"/>
  <bpmn:sequenceFlow id="f12" sourceRef="G" targetRef="H"/>
  <bpmn:sequenceFlow id="f13" sourceRef="H" targetRef="I"/>
  <bpmn:sequenceFlow id="f14" sourceRef="I" targetRef="J"/>
 </bpmn:process>
 <bpmndi:BPMNDiagram id="BPMNDiagram_ITServiceRequest">
  <bpmndi:BPMNPlane id="BPMNPlane_ITServiceRequest" bpmnElement="ITServiceRequest">
