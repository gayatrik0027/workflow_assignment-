<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_LeaveApproval" targetNamespace="http://example.com/bpmn">
 <bpmn:process id="LeaveApproval" name="Employee Leave Approval" isExecutable="true">
  <bpmn:startEvent id="Start" name="Employee submits leave request"/>
  <bpmn:task id="A" name="Check leave balance"/>
  <bpmn:exclusiveGateway id="G1" name="Sufficient leave balance?"/>
  <bpmn:task id="B" name="Send request to manager"/>
  <bpmn:exclusiveGateway id="G2" name="Manager approves?"/>
  <bpmn:task id="C" name="Update employee leave balance"/>
  <bpmn:task id="D" name="Send approval notification"/>
  <bpmn:endEvent id="E" name="Process ends"/>
  <bpmn:task id="F" name="Send rejection notification"/>
  <bpmn:endEvent id="G" name="Process ends"/>
  <bpmn:task id="H" name="Send insufficient-balance notification"/>
  <bpmn:endEvent id="I" name="Process ends"/>
  <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="A"/>
  <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="G1"/>
  <bpmn:sequenceFlow id="f3" sourceRef="G1" targetRef="B" name="Yes"/>
  <bpmn:sequenceFlow id="f4" sourceRef="G1" targetRef="H" name="No"/>
  <bpmn:sequenceFlow id="f5" sourceRef="H" targetRef="I"/>
  <bpmn:sequenceFlow id="f6" sourceRef="B" targetRef="G2"/>
  <bpmn:sequenceFlow id="f7" sourceRef="G2" targetRef="C" name="Yes"/>
  <bpmn:sequenceFlow id="f8" sourceRef="G2" targetRef="F" name="No"/>
  <bpmn:sequenceFlow id="f9" sourceRef="C" targetRef="D"/>
  <bpmn:sequenceFlow id="f10" sourceRef="D" targetRef="E"/>
  <bpmn:sequenceFlow id="f11" sourceRef="F" targetRef="G"/>
 </bpmn:process>
