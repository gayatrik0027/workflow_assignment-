   <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
    <di:waypoint x="675" y="325"/>
    <di:waypoint x="675" y="400"/>
    <di:waypoint x="750" y="400"/>
   </bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
    <di:waypoint x="980" y="400"/>
    <di:waypoint x="1030" y="400"/>
   </bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
    <di:waypoint x="700" y="300"/>
