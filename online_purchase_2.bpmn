   </bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
    <di:waypoint x="1160" y="290"/>
    <di:waypoint x="1220" y="290"/>
   </bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
    <di:waypoint x="1420" y="290"/>
    <di:waypoint x="1460" y="290"/>
   </bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane>
 </bpmndi:BPMNDiagram>
